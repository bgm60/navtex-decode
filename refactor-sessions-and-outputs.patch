-    @property
-    def level(self) -> int:
-        if not self._values:
-            return 0
-        avg = sum(self._values) / len(self._values)
-        scaled = (avg - self.FLOOR) / (self.CEILING - self.FLOOR)
-        return max(0, min(99, round(scaled * 99)))
